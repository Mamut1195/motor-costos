        "suggested_action"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "RoundingPolicy": {
      "additionalProperties": false,
      "description": "When and how the cascade rounds. See ADR 0001.\n\n`exact`     - never quantise; reproduces full-precision Decimal arithmetic.\n`final`     - exact intermediates, final unit cost quantised (the default).\n`per-stage` - quantise every stage before it feeds the next.",
      "properties": {
        "mode": {
          "default": "final",
          "enum": [
            "exact",
            "final",
            "per-stage"
          ],
          "title": "Mode",
          "type": "string"
        },
        "money_scale": {
          "default": 4,
          "maximum": 10,
          "minimum": 0,
          "title": "Money Scale",
          "type": "integer"
        }
      },
      "title": "RoundingPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
